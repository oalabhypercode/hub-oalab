# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: server-only provisioning of the four demo accounts.
# Never use a NEXT_PUBLIC_ prefix for this key. See DEMO_ACCOUNTS.md.
# SUPABASE_SECRET_KEY=your-project-secret-key

# Optional: hide/disable the local real-account shortcut (never enabled in production).
# ENABLE_DEMO_LOGIN=false

# Optional: isolated PUBLIC fixture demo on one explicitly configured HTTPS origin.
# These server-only settings do NOT need Supabase passwords or an admin key.
# ENABLE_PUBLIC_DEMO_LOGIN=true
# PUBLIC_DEMO_ORIGIN=https://oalab-client-hub.vercel.app
# OALAB_DEMO_SESSION_SECRET=<random server-side secret, at least 32 characters>

# Optional: KI-Assistent im Hub (Claude). Server-only, never with a NEXT_PUBLIC_ prefix. See README.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: WhatsApp-Anbindung (Meta WhatsApp Cloud API). Server-only. See README.
# WHATSAPP_ACCESS_TOKEN=permanent-system-user-token
# WHATSAPP_PHONE_NUMBER_ID=phone-number-id
# WHATSAPP_APP_SECRET=meta-app-secret
# WHATSAPP_VERIFY_TOKEN=self-chosen-verify-token
# WHATSAPP_BUSINESS_NUMBER=49301234567
# WHATSAPP_SUPPORT_CONTACT=info@oalab.de
