# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: server-only provisioning of the four demo accounts.
# Never use a NEXT_PUBLIC_ prefix for this key. See DEMO_ACCOUNTS.md.
# SUPABASE_SECRET_KEY=your-project-secret-key

# Optional: hide/disable the local one-click demo login. Production always disables it.
# ENABLE_DEMO_LOGIN=false
